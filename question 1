 #include <stdio.h>
int main()
{
    int price, qty, senior;
    int total, net;

    // Bill 1
    price = 100;
    qty = 2;
    senior = 1;

    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = (total > 1000) ? total - 50 : total;

    printf("Bill 1 Total = %d\n", total);
    printf("Bill 1 Net = %d\n\n", net);

    // Bill 2
    price = 250;
    qty = 3;
    senior = 0;

    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = (total > 1000) ? total - 50 : total;

    printf("Bill 2 Total = %d\n", total);
    printf("Bill 2 Net = %d\n\n", net);

    // Bill 3
    price = 400;
    qty = 3;
    senior = 1;

    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = (total > 1000) ? total - 50 : total;

    printf("Bill 3 Total = %d\n", total);
    printf("Bill 3 Net = %d\n", net);

    return 0;
}
